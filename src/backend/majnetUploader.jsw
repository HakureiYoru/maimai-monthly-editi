/**
 * Majnet 上传模块
 * 自动将wix数据集中的谱面上传到majnet平台
 */

import { fetch } from "wix-fetch";
import { mediaManager } from "wix-media-backend";
import { getSecret } from "wix-secrets-backend";
import { getFileDownloadUrlAndContent } from "backend/mediaManagement.jsw";
import {
  logInfo,
  logError,
  safeExecute,
} from "backend/errorHandler";

// Majnet API配置。cn 入口优先，主站作为 Cloudflare/Wix 出站兼容回退。
const MAJNET_CONFIG = {
  ENDPOINTS: [
    {
      name: "cn",
      apiRoot: "https://cn.majdata.net/api3/api",
      referer: "https://cn.majdata.net/",
    },
    {
      name: "main",
      apiRoot: "https://majdata.net/api3/api",
      referer: "https://majdata.net/",
    },
  ],
  USERNAME: "mmfc_bot",
  FALLBACK_DESIGNER: "mmfc",
  UPLOAD_DELAY: 2000, // 上传间隔（毫秒）
  BASE_TIMEOUT: 30000, // 基础超时（毫秒）
  MAX_TIMEOUT: 120000, // 最大超时（毫秒）
  USER_AGENT: "MajdataPlay/0.1.0-upload (Windows NT 10.0; Win64; x64)",
};

// 全局会话状态。Wix 后端会复用热实例，但不能假设模块状态永久存在。
let sessionToken = null;
let lastLoginTime = null;
let sessionTokenSource = null;
let activeEndpoint = MAJNET_CONFIG.ENDPOINTS[0];
let loginPromise = null;
let secretLoadPromise = null;
let secretLoadAttempted = false;
let secretLoadDetail = "尚未读取预授权会话";
const SESSION_TOKEN_SECRET_NAME = "MAJNET_SESSION_TOKEN";
// mmfcapi 的普通用户会话有效期为 7 天。这里取 24 小时，既减少重复登录，
// 又会定期主动刷新；服务端重启导致 token 提前失效时由上传 401 分支处理。
const SESSION_TIMEOUT = 24 * 60 * 60 * 1000;

// ========== 请求队列管理 ==========
class UploadQueue {
  constructor() {
    this.queue = []; // 待处理的任务队列
    this.isProcessing = false; // 是否正在处理任务
    this.currentTask = null; // 当前正在执行的任务
    this.lastUploadTime = 0; // 上次上传完成时间
  }

  /**
   * 添加上传任务到队列
   * @param {Function} uploadTask - 上传任务函数
   * @param {string} taskId - 任务ID（用于日志）
   * @returns {Promise} 返回上传结果的Promise
   */
  async enqueue(uploadTask, taskId) {
    return new Promise((resolve, reject) => {
      const task = {
        id: taskId,
        execute: uploadTask,
        resolve,
        reject,
        addedAt: Date.now(),
      };

      this.queue.push(task);
      logInfo(
        "UploadQueue",
        `任务已加入队列: ${taskId} | 队列长度: ${this.queue.length}`
      );

      // 如果没有正在处理，立即开始处理
      if (!this.isProcessing) {
        this.processQueue();
      }
    });
  }

  /**
   * 处理队列中的任务
   */
  async processQueue() {
    if (this.isProcessing || this.queue.length === 0) {
      return;
    }

    this.isProcessing = true;

    while (this.queue.length > 0) {
      const task = this.queue.shift();
      this.currentTask = task;

      try {
        // 确保两次上传之间有足够的间隔
        const timeSinceLastUpload = Date.now() - this.lastUploadTime;
        if (timeSinceLastUpload < MAJNET_CONFIG.UPLOAD_DELAY) {
          const waitTime = MAJNET_CONFIG.UPLOAD_DELAY - timeSinceLastUpload;
          logInfo(
            "UploadQueue",
            `等待 ${waitTime}ms 后执行任务: ${task.id}`
          );
          await new Promise((resolve) => setTimeout(resolve, waitTime));
        }

        const waitTime = Date.now() - task.addedAt;
        logInfo(
          "UploadQueue",
          `开始执行任务: ${task.id} | 等待时长: ${(waitTime / 1000).toFixed(1)}秒 | 剩余队列: ${this.queue.length}`
        );

        // 执行上传任务
        const result = await task.execute();
        this.lastUploadTime = Date.now();

        // 返回结果给调用者
        task.resolve(result);

        logInfo(
          "UploadQueue",
          `任务完成: ${task.id} | 成功: ${result.success}`
        );
      } catch (error) {
        logError("UploadQueue", `任务执行失败: ${task.id} - ${error.message}`);
        task.reject(error);
      } finally {
        this.currentTask = null;
      }
    }

    this.isProcessing = false;
    logInfo("UploadQueue", "队列处理完成");
  }

  /**
   * 获取队列状态
   */
  getStatus() {
    return {
      queueLength: this.queue.length,
      isProcessing: this.isProcessing,
      currentTask: this.currentTask ? this.currentTask.id : null,
      lastUploadTime: this.lastUploadTime,
    };
  }
}

// 全局上传队列实例
const uploadQueue = new UploadQueue();

/**
 * 旧登录流程使用的密码 MD5。服务端直接将该值视作凭据，禁止记录到日志。
 * Wix 正常上传优先使用 Secrets Manager 中的预授权 token。
 */
const PASSWORD_MD5 = "0c95eabfbdfdb54a9fd6aac5dccdcc0f";

/**
 * 获取通用请求头。
 *
 * 这里刻意与正常工作的 upload_cli.py 保持一致，不伪造 Sec-Fetch 等
 * 浏览器导航头。Wix 后端实际使用 node-fetch，带着浏览器导航头反而会
 * 形成相互矛盾的请求指纹，增加 Cloudflare 拦截概率。
 */
function getCommonHeaders(endpoint = activeEndpoint) {
  return {
    "User-Agent": MAJNET_CONFIG.USER_AGENT,
    Accept: "*/*",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
    "Accept-Encoding": "gzip, deflate",
    Referer: endpoint.referer,
  };
}

/**
 * 从 node-fetch/Wix Fetch 的响应头中提取 token cookie。
 * Cookie 请求头只能包含 name=value，不能把 Path/Expires/SameSite 等
 * Set-Cookie 属性原样发回服务器。
 */
function extractSessionToken(headers) {
  const cookieHeaders = [];

  if (headers && typeof headers.raw === "function") {
    const rawHeaders = headers.raw();
    const rawCookies = rawHeaders && rawHeaders["set-cookie"];
    if (Array.isArray(rawCookies)) {
      cookieHeaders.push(...rawCookies);
    }
  }

  if (headers && typeof headers.get === "function") {
    const combinedCookie = headers.get("set-cookie");
    if (combinedCookie) {
      cookieHeaders.push(combinedCookie);
    }
  }

  for (const cookieHeader of cookieHeaders) {
    const match = String(cookieHeader).match(/(?:^|[,;]\s*)token=([^;,]+)/i);
    if (match && match[1]) {
      return match[1].trim();
    }
  }

  return null;
}

function parseResponseJson(responseText) {
  try {
    return JSON.parse(responseText);
  } catch (error) {
    return null;
  }
}

function getResponseSummary(response, responseText) {
  const responseJson = parseResponseJson(responseText);
  const contentType = response.headers.get("content-type") || "";
  const servedByCloudflare =
    (response.headers.get("server") || "").toLowerCase() === "cloudflare" ||
    Boolean(response.headers.get("cf-ray"));
  const isCloudflareHtml =
    contentType.toLowerCase().includes("text/html") &&
    /cloudflare|cf-ray|attention required|challenge/i.test(responseText);
  const compactBody = String(responseText || "")
    .replace(/\s+/g, " ")
    .trim()
    .substring(0, 300);

  if (responseJson && typeof responseJson === "object") {
    const code = responseJson.code;
    const message = responseJson.message || responseJson.msg || compactBody;
    return {
      code,
      detail: `MajdataNet API: code=${code}, message=${message || "未知错误"}`,
      retryOtherEndpoint: response.status >= 500,
    };
  }

  if (
    isCloudflareHtml ||
    response.headers.get("cf-mitigated") === "challenge" ||
    (response.status === 403 && servedByCloudflare)
  ) {
    return {
      code: null,
      detail: "Cloudflare 拦截了 Wix 后端请求",
      retryOtherEndpoint: true,
    };
  }

  return {
    code: null,
    detail: compactBody || response.statusText || "空响应",
    retryOtherEndpoint: response.status >= 500,
  };
}

function getEndpointCandidates() {
  return [
    activeEndpoint,
    ...MAJNET_CONFIG.ENDPOINTS.filter(
      (endpoint) => endpoint.name !== activeEndpoint.name
    ),
  ];
}

function clearSession() {
  sessionToken = null;
  lastLoginTime = null;
  sessionTokenSource = null;
}

function normalizeSessionToken(value) {
  const rawValue = String(value || "").trim();
  const cookieMatch = rawValue.match(
    /(?:^|[;,]\s*)token=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i
  );

  if (cookieMatch) {
    return cookieMatch[1];
  }

  if (
    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
      rawValue
    )
  ) {
    return rawValue;
  }

  return null;
}

/**
 * Wix 的出站 IP 会被 MajdataNet 的 Cloudflare 登录规则拦截，因此优先从
 * Secrets Manager 读取在本机预先登录得到的持久会话。Secret 只在后端使用，
 * 不写入日志，也不会返回给前端。
 */
async function loadSessionFromSecret() {
  if (sessionToken) {
    return sessionTokenSource === "secret";
  }

  if (secretLoadPromise) {
    return secretLoadPromise;
  }

  if (secretLoadAttempted) {
    return false;
  }

  secretLoadPromise = (async () => {
    try {
      const secretValue = await getSecret(SESSION_TOKEN_SECRET_NAME);
      const token = normalizeSessionToken(secretValue);

      if (!token) {
        secretLoadDetail = `Wix Secret ${SESSION_TOKEN_SECRET_NAME} 不是有效的 MajdataNet token`;
        logInfo("loadSessionFromSecret", secretLoadDetail);
        return false;
      }

      sessionToken = token;
      sessionTokenSource = "secret";
      lastLoginTime = Date.now();
      secretLoadDetail = `已读取 Wix Secret ${SESSION_TOKEN_SECRET_NAME}`;
      logInfo("loadSessionFromSecret", "已加载 MajdataNet 预授权会话");
      return true;
    } catch (error) {
      secretLoadDetail = `无法读取 Wix Secret ${SESSION_TOKEN_SECRET_NAME}: ${error.message}`;
      logInfo(
        "loadSessionFromSecret",
        `未加载 MajdataNet 预授权会话，将尝试常规登录: ${error.message}`
      );
      return false;
    } finally {
      secretLoadAttempted = true;
      secretLoadPromise = null;
    }
  })();

  return secretLoadPromise;
}

function invalidateSecretSession() {
  clearSession();
  // 允许下一个上传任务重新读取管理员刚刚更新过的 Secret。
  secretLoadAttempted = false;
  secretLoadDetail = `Wix Secret ${SESSION_TOKEN_SECRET_NAME} 中的 token 已失效`;
}

/**
 * 登录Majnet
 */
async function loginToMajnet() {
  // 检查会话是否仍然有效
  if (
    sessionToken &&
    (sessionTokenSource === "secret" ||
      (lastLoginTime && Date.now() - lastLoginTime < SESSION_TIMEOUT))
  ) {
    logInfo("loginToMajnet", "使用现有会话");
    return { success: true, message: "使用缓存会话" };
  }

  if (await loadSessionFromSecret()) {
    return { success: true, message: "使用预授权会话" };
  }

  // 同一热实例内只允许一个登录请求，避免并发任务重复撞登录接口。
  if (loginPromise) {
    return loginPromise;
  }

  loginPromise = safeExecute(
    async () => {
      clearSession();
      const attempts = [];
      const formBody = [
        `username=${encodeURIComponent(MAJNET_CONFIG.USERNAME)}`,
        `password=${encodeURIComponent(PASSWORD_MD5)}`,
        "rememberMe=false",
      ].join("&");

      for (const endpoint of getEndpointCandidates()) {
        try {
          logInfo("loginToMajnet", `开始登录 (${endpoint.name})`);

          const response = await fetch(
            `${endpoint.apiRoot}/account/Login`,
            {
              method: "POST",
              headers: {
                ...getCommonHeaders(endpoint),
                "Content-Type": "application/x-www-form-urlencoded",
              },
              body: formBody,
            }
          );
          const responseText = await response.text();

          if (response.status === 200) {
            const token = extractSessionToken(response.headers);
            if (!token) {
              const detail = "登录返回 200，但响应中没有 token cookie";
              attempts.push(`${endpoint.name}: ${detail}`);
              logError("loginToMajnet", new Error(detail));
              continue;
            }

            sessionToken = token;
            sessionTokenSource = "login";
            lastLoginTime = Date.now();
            activeEndpoint = endpoint;

            logInfo("loginToMajnet", `✅ 登录成功 (${endpoint.name})`);
            return {
              success: true,
              message: "登录成功",
              statusCode: response.status,
              endpoint: endpoint.name,
            };
          }

          const summary = getResponseSummary(response, responseText);
          const attemptDetail = `${endpoint.name}: HTTP ${response.status}, ${summary.detail}`;
          attempts.push(attemptDetail);
          logError("loginToMajnet", new Error(`❌ 登录失败: ${attemptDetail}`));

          // 业务错误在两个域名上结果相同，不要用另一个入口重复撞登录接口。
          if (!summary.retryOtherEndpoint) {
            return {
              success: false,
              message: attemptDetail,
              statusCode: response.status,
              error: responseText,
              code: summary.code,
            };
          }
        } catch (error) {
          const attemptDetail = `${endpoint.name}: ${error.message}`;
          attempts.push(attemptDetail);
          logError("loginToMajnet", new Error(`❌ 登录异常: ${attemptDetail}`));
        }
      }

      clearSession();
      return {
        success: false,
        message:
          `所有 MajdataNet 入口均登录失败 (${attempts.join(" | ")})；` +
          `${secretLoadDetail}。请在 Wix Secrets Manager 配置 ${SESSION_TOKEN_SECRET_NAME}`,
        error: attempts.join(" | "),
      };
    },
    "loginToMajnet",
    { success: false, message: "登录异常" }
  );

  try {
    return await loginPromise;
  } finally {
    loginPromise = null;
  }
}

/**
 * 确保maidata.txt中有designer字段
 */
function ensureDesigner(maidataContent) {
  if (!maidataContent || typeof maidataContent !== "string") {
    logError("ensureDesigner", "maidata内容无效");
    return `&des=${MAJNET_CONFIG.FALLBACK_DESIGNER}\n`;
  }

  const lines = maidataContent.split("\n");
  let hasDesigner = false;

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (line.toLowerCase().startsWith("&des=")) {
      const value = line.split("=")[1]?.trim();
      if (!value) {
        lines[i] = `&des=${MAJNET_CONFIG.FALLBACK_DESIGNER}`;
        logInfo("ensureDesigner", "补充了空的designer字段");
      }
      hasDesigner = true;
      break;
    }
  }

  if (!hasDesigner) {
    // 在文件开头添加designer（更安全）
    lines.unshift(`&des=${MAJNET_CONFIG.FALLBACK_DESIGNER}`);
    logInfo("ensureDesigner", "添加了缺失的designer字段");
  }

  return lines.join("\n");
}

/**
 * 获取文件的二进制内容
 */
async function getFileBinary(fileUrl) {
  return safeExecute(
    async () => {
      const downloadUrl = await mediaManager.getDownloadUrl(fileUrl);
      const response = await fetch(downloadUrl);

      if (!response.ok) {
        throw new Error(`获取文件失败: ${response.status}`);
      }

      // Wix Velo 使用 buffer() 而不是 arrayBuffer()
      const buffer = await response.buffer();
      return {
        buffer: buffer,
        contentType: response.headers.get("content-type"),
      };
    },
    "getFileBinary",
    null
  );
}

/**
 * 根据文件大小计算动态超时时间
 * @param {number} totalSizeBytes - 文件总大小（字节）
 * @returns {number} 超时时间（毫秒）
 */
function calculateDynamicTimeout(totalSizeBytes) {
  const sizeMB = totalSizeBytes / (1024 * 1024);
  // 每10MB增加15秒
  const extraTimeout = Math.floor(sizeMB / 10) * 15000;
  const calculatedTimeout = MAJNET_CONFIG.BASE_TIMEOUT + extraTimeout;
  
  // 限制在最大超时范围内
  const finalTimeout = Math.min(calculatedTimeout, MAJNET_CONFIG.MAX_TIMEOUT);
  
  logInfo(
    "calculateDynamicTimeout",
    `文件大小: ${sizeMB.toFixed(1)}MB, 超时: ${finalTimeout / 1000}秒`
  );
  
  return finalTimeout;
}

/**
 * 构建multipart/form-data请求体
 */
function buildMultipartFormData(files) {
  const boundary =
    "----WebKitFormBoundary" + Math.random().toString(36).substr(2);
  const parts = [];

  for (const file of files) {
    const { filename, content, contentType } = file;

    // 构建文件头部
    let header = "";
    header += `--${boundary}\r\n`;
    header += `Content-Disposition: form-data; name="formfiles"; filename="${filename}"\r\n`;
    header += `Content-Type: ${contentType}\r\n\r\n`;

    // 添加头部（字符串转Buffer）
    parts.push(Buffer.from(header, "utf8"));

    // 添加内容（可能是字符串或Buffer）
    if (typeof content === "string") {
      parts.push(Buffer.from(content, "utf8"));
    } else {
      parts.push(content); // 已经是Buffer
    }

    // 添加分隔符
    parts.push(Buffer.from("\r\n", "utf8"));
  }

  // 添加结束边界
  parts.push(Buffer.from(`--${boundary}--\r\n`, "utf8"));

  // 合并所有Buffer
  const body = Buffer.concat(parts);

  return {
    body: body,
    boundary,
    totalSize: body.length,
  };
}

/**
 * 上传谱面到Majnet（带队列管理）
 * @param {Object} chartData - 包含文件URL的谱面数据
 * @param {boolean} skipQueue - 是否跳过队列（批量上传时使用）
 * @returns {Promise<Object>} 上传结果
 */
export async function uploadChartToMajnet(chartData, skipQueue = false) {
  const chartTitle = chartData.chartTitle || "未命名";
  const taskId = `${chartTitle}_${Date.now()}`;

  // 如果不跳过队列，则加入队列等待执行
  if (!skipQueue) {
    logInfo("uploadChartToMajnet", `任务加入队列: ${chartTitle}`);
    const queueStatus = uploadQueue.getStatus();
    logInfo(
      "uploadChartToMajnet",
      `当前队列状态: 队列长度=${queueStatus.queueLength}, 正在处理=${queueStatus.isProcessing}`
    );

    return uploadQueue.enqueue(
      () => uploadChartToMajnetInternal(chartData),
      taskId
    );
  }

  // 批量上传时直接执行（已在批量函数中控制延迟）
  return uploadChartToMajnetInternal(chartData);
}

/**
 * 上传谱面到Majnet的内部实现
 * @param {Object} chartData - 包含文件URL的谱面数据
 * @returns {Promise<Object>} 上传结果
 */
async function uploadChartToMajnetInternal(chartData) {
  return safeExecute(
    async () => {
      const {
        maidataUrl, // maidata.txt的wix URL
        trackUrl, // track.mp3的wix URL
        bgUrl, // bg.png/jpg的wix URL
        bgVideoUrl, // 背景视频URL（可选）
        chartTitle, // 谱面标题（用于日志）
      } = chartData;

      logInfo("uploadChartToMajnet", `开始上传谱面: ${chartTitle || "未命名"}`);

      // 1. 确保已登录
      const loginResult = await loginToMajnet();
      if (!loginResult.success) {
        const majnetUploadMessage = `❌ 登录Majnet失败\n错误信息: ${loginResult.message}\n失败时间: ${new Date().toLocaleString('zh-CN')}`;
        return {
          success: false,
          message: "登录失败",
          error: loginResult.message,
          majnetUploadMessage: majnetUploadMessage,
        };
      }

      // 2. 获取所有文件
      const files = [];

      try {
        // 2.1 获取maidata.txt
        if (!maidataUrl) {
          throw new Error("缺少maidata.txt文件");
        }
        logInfo("uploadChartToMajnet", "正在获取maidata.txt...");
        const maidataResult = await getFileDownloadUrlAndContent(maidataUrl);
        if (!maidataResult || !maidataResult.fileContent) {
          throw new Error("maidata.txt内容为空");
        }
        const maidataContent = ensureDesigner(maidataResult.fileContent);
        files.push({
          filename: "maidata.txt",
          content: maidataContent,
          contentType: "text/plain",
        });
        logInfo("uploadChartToMajnet", "maidata.txt准备完成");

        // 2.2 获取背景图
        if (!bgUrl) {
          throw new Error("缺少背景图文件");
        }
        logInfo("uploadChartToMajnet", "正在获取背景图...");
        const bgBinary = await getFileBinary(bgUrl);
        if (!bgBinary || !bgBinary.buffer) {
          throw new Error("背景图获取失败");
        }
        const bgExtension = bgUrl.toLowerCase().includes(".jpg")
          ? "jpg"
          : "png";
        files.push({
          filename: `bg.${bgExtension}`,
          content: bgBinary.buffer,
          contentType: bgBinary.contentType || `image/${bgExtension}`,
        });
        logInfo("uploadChartToMajnet", `背景图准备完成 (${bgExtension})`);

        // 2.3 获取音频文件
        if (!trackUrl) {
          throw new Error("缺少音频文件");
        }
        logInfo("uploadChartToMajnet", "正在获取音频文件...");
        const trackBinary = await getFileBinary(trackUrl);
        if (!trackBinary || !trackBinary.buffer) {
          throw new Error("音频文件获取失败");
        }
        files.push({
          filename: "track.mp3",
          content: trackBinary.buffer,
          contentType: trackBinary.contentType || "audio/mpeg",
        });
        logInfo("uploadChartToMajnet", "音频文件准备完成");

        // 2.4 获取视频（如果有）
        if (bgVideoUrl) {
          const videoBinary = await getFileBinary(bgVideoUrl);
          const videoExtension = bgVideoUrl.toLowerCase().includes("pv.mp4")
            ? "pv.mp4"
            : "bg.mp4";
          files.push({
            filename: videoExtension,
            content: videoBinary.buffer,
            contentType: videoBinary.contentType || "video/mp4",
          });
        }
      } catch (error) {
        logError("uploadChartToMajnet", `文件准备失败: ${error.message}`);
        const majnetUploadMessage = `❌ 文件准备失败\n错误信息: ${error.message}\n失败时间: ${new Date().toLocaleString('zh-CN')}`;
        return {
          success: false,
          message: "文件准备失败",
          error: error.message,
          majnetUploadMessage: majnetUploadMessage,
        };
      }

      // 3. 构建并发送上传请求
      return await uploadToMajnet(files, chartTitle);
    },
    "uploadChartToMajnet",
    {
      success: false,
      message: "上传异常",
      majnetUploadMessage: `❌ 上传过程中发生异常\n失败时间: ${new Date().toLocaleString('zh-CN')}`,
    }
  );
}

/**
 * 上传文件到Majnet
 * @param {Array} files - 文件数组
 * @param {string} chartTitle - 谱面标题
 * @returns {Promise<Object>} 上传结果
 */
async function uploadToMajnet(files, chartTitle) {
  return safeExecute(
    async () => {
      logInfo("uploadToMajnet", `准备上传 ${files.length} 个文件...`);
      
      // 构建请求体
      const formData = buildMultipartFormData(files);
      const totalSizeMB = (formData.totalSize / (1024 * 1024)).toFixed(1);
      logInfo(
        "uploadToMajnet",
        `请求体构建完成，大小: ${totalSizeMB}MB`
      );

      // 计算动态超时
      const currentTimeout = calculateDynamicTimeout(formData.totalSize);
      
      try {
        logInfo(
          "uploadToMajnet",
          `开始上传: ${chartTitle} (超时: ${currentTimeout / 1000}秒)`
        );

        if (!sessionToken) {
          throw new Error("上传前没有可用的 MajdataNet token");
        }

        let requestEndpoint = activeEndpoint;
        const headers = {
          ...getCommonHeaders(requestEndpoint),
          "Content-Type": `multipart/form-data; boundary=${formData.boundary}`,
          Cookie: `token=${sessionToken}`,
        };

        // 发送上传请求
        let response = await fetch(`${requestEndpoint.apiRoot}/maichart/upload`, {
          method: "POST",
          headers,
          body: formData.body,
        });

        let responseText = await response.text();
        let responseSummary = getResponseSummary(response, responseText);

        // 遇到明确的 401 时，预授权 token 需要管理员更新 Secret；旧登录流程
        // 产生的普通会话则重新登录并重发当前上传一次。
        if (response.status === 401) {
          const expiredTokenSource = sessionTokenSource;

          if (expiredTokenSource === "secret") {
            invalidateSecretSession();
            responseSummary = {
              ...responseSummary,
              detail:
                `${responseSummary.detail}; Wix Secret ${SESSION_TOKEN_SECRET_NAME} ` +
                "中的预授权 token 已失效，请重新生成并更新 Secret",
            };
          } else {
            clearSession();
            const reloginResult = await loginToMajnet();

            if (reloginResult.success && sessionToken) {
              requestEndpoint = activeEndpoint;
              response = await fetch(
                `${requestEndpoint.apiRoot}/maichart/upload`,
                {
                  method: "POST",
                  headers: {
                    ...getCommonHeaders(requestEndpoint),
                    "Content-Type": `multipart/form-data; boundary=${formData.boundary}`,
                    Cookie: `token=${sessionToken}`,
                  },
                  body: formData.body,
                }
              );
              responseText = await response.text();
              responseSummary = getResponseSummary(response, responseText);
            } else {
              responseSummary = {
                ...responseSummary,
                detail: `${responseSummary.detail}; 重新登录失败: ${reloginResult.message}`,
              };
            }
          }
        }

        // cn 与主站处于不同的 Cloudflare 入口。边缘层拦截时用同一 token
        // 切换入口重试一次；MajdataNet 返回的业务 403 不会在这里重试。
        if (response.status === 403 && responseSummary.retryOtherEndpoint) {
          const fallbackEndpoint = MAJNET_CONFIG.ENDPOINTS.find(
            (endpoint) => endpoint.name !== requestEndpoint.name
          );

          if (fallbackEndpoint) {
            logInfo(
              "uploadToMajnet",
              `${requestEndpoint.name} 入口被 Cloudflare 拦截，切换到 ${fallbackEndpoint.name}`
            );
            requestEndpoint = fallbackEndpoint;
            response = await fetch(
              `${requestEndpoint.apiRoot}/maichart/upload`,
              {
                method: "POST",
                headers: {
                  ...getCommonHeaders(requestEndpoint),
                  "Content-Type": `multipart/form-data; boundary=${formData.boundary}`,
                  Cookie: `token=${sessionToken}`,
                },
                body: formData.body,
              }
            );
            responseText = await response.text();
            responseSummary = getResponseSummary(response, responseText);
          }
        }

        logInfo(
          "uploadToMajnet",
          `收到响应 (${requestEndpoint.name})，状态码: ${response.status}`
        );

        // 成功
        if (response.status === 200) {
          activeEndpoint = requestEndpoint;
          logInfo(
            "uploadToMajnet",
            `✅ 上传成功: ${chartTitle} - 响应: ${responseText.substring(0, 200)}`
          );
          
          // 构建详细的上传消息
          let majnetUploadMessage = `✅ 上传成功\n`;
          majnetUploadMessage += `服务器响应: ${responseText}\n`;
          majnetUploadMessage += `状态码: ${response.status}\n`;
          majnetUploadMessage += `上传时间: ${new Date().toLocaleString('zh-CN')}`;
          
          return {
            success: true,
            message: "上传成功",
            statusCode: response.status,
            response: responseText,
            majnetUploadMessage: majnetUploadMessage,
          };
        }

        // 服务器拒绝（4xx/5xx）
        if (response.status >= 400 && response.status < 600) {
          if (response.status === 401) {
            clearSession();
          }

          const errorMsg = `入口${requestEndpoint.name} | 状态码${response.status} | ${responseSummary.detail} | 作品: ${chartTitle} | 文件数: ${files.length}`;
          logError("uploadToMajnet", new Error(`❌ 服务器拒绝: ${errorMsg}`));

          // 构建详细的错误消息
          let majnetUploadMessage = `❌ 服务器拒绝上传\n`;
          majnetUploadMessage += `请求入口: ${requestEndpoint.name}\n`;
          majnetUploadMessage += `状态码: ${response.status}\n`;
          majnetUploadMessage += `错误详情: ${responseSummary.detail}\n`;
          
          // 如果是400错误，额外记录请求详情
          if (response.status === 400) {
            const fileList = files.map((f) => f.filename).join(", ");
            majnetUploadMessage += `文件列表: ${fileList}\n`;
            majnetUploadMessage += `总大小: ${totalSizeMB}MB\n`;
            logError(
              "uploadToMajnet - 400详情",
              new Error(`文件列表: [${fileList}] | 大小: ${totalSizeMB}MB`)
            );
          }
          
          majnetUploadMessage += `失败时间: ${new Date().toLocaleString('zh-CN')}`;

          return {
            success: false,
            message: `❌ 服务器拒绝，状态码 ${response.status}`,
            statusCode: response.status,
            error: responseText,
            details: errorMsg,
            majnetUploadMessage: majnetUploadMessage,
          };
        }

        // 其他状态码
        const majnetUploadMessage = `❌ 上传失败\n错误信息: 状态码 ${response.status}\n失败时间: ${new Date().toLocaleString('zh-CN')}`;
        return {
          success: false,
          message: `❌ 上传失败: 状态码 ${response.status}`,
          error: `状态码 ${response.status}`,
          majnetUploadMessage: majnetUploadMessage,
        };
        
      } catch (error) {
        // 判断错误类型
        const errorMsg = error.message || String(error);
        
        if (errorMsg.includes("timeout") || errorMsg.includes("ETIMEDOUT")) {
          const majnetUploadMessage = `❌ 网络超时\n错误信息: 请求超过 ${currentTimeout / 1000} 秒未响应\n失败时间: ${new Date().toLocaleString('zh-CN')}`;
          logError("uploadToMajnet", `⏱️ 超时: ${chartTitle}`);
          return {
            success: false,
            message: "❌ 网络超时",
            error: `请求超过 ${currentTimeout / 1000} 秒未响应`,
            majnetUploadMessage: majnetUploadMessage,
          };
        } else if (
          errorMsg.includes("ECONNREFUSED") ||
          errorMsg.includes("ENOTFOUND") ||
          errorMsg.includes("ECONNRESET") ||
          errorMsg.includes("connect")
        ) {
          const majnetUploadMessage = `❌ 连接错误\n错误信息: 无法连接到服务器\n失败时间: ${new Date().toLocaleString('zh-CN')}`;
          logError("uploadToMajnet", `🔌 连接错误: ${chartTitle}`);
          return {
            success: false,
            message: "❌ 连接错误",
            error: "无法连接到服务器",
            majnetUploadMessage: majnetUploadMessage,
          };
        } else {
          const majnetUploadMessage = `❌ 上传失败\n错误信息: ${errorMsg}\n失败时间: ${new Date().toLocaleString('zh-CN')}`;
          logError("uploadToMajnet", `❌ 未知错误: ${errorMsg}`);
          return {
            success: false,
            message: "❌ 上传失败",
            error: errorMsg,
            majnetUploadMessage: majnetUploadMessage,
          };
        }
      }
    },
    "uploadToMajnet",
    {
      success: false,
      message: "上传异常",
      majnetUploadMessage: `❌ 上传请求过程中发生异常\n失败时间: ${new Date().toLocaleString('zh-CN')}`,
    }
  );
}

/**
 * 从wix数据集项上传到Majnet
 * @param {Object} contestItem - enterContest034数据集项
 * @param {boolean} skipQueue - 是否跳过队列（批量上传时使用）
 * @returns {Promise<Object>} 上传结果
 */
export async function uploadContestItemToMajnet(contestItem, skipQueue = false) {
  return safeExecute(
    async () => {
      // 映射字段名（根据http-functions.js中的字段映射）
      const chartData = {
        maidataUrl: contestItem.inVideo的複本, // maidata.txt
        trackUrl: contestItem.maidata的複本, // track.mp3
        bgUrl: contestItem.track的複本, // bg.png/jpg
        bgVideoUrl: contestItem.上傳檔案欄, // 背景视频
        chartTitle: contestItem.firstName, // 作品标题
      };

      // 记录字段映射情况
      logInfo(
        "uploadContestItemToMajnet",
        `字段映射: maidata=${!!chartData.maidataUrl}, track=${!!chartData.trackUrl}, bg=${!!chartData.bgUrl}, video=${!!chartData.bgVideoUrl}, title=${
          chartData.chartTitle
        }`
      );

      return await uploadChartToMajnet(chartData, skipQueue);
    },
    "uploadContestItemToMajnet",
    {
      success: false,
      message: "上传失败",
      majnetUploadMessage: `❌ 上传数据集项目时发生异常\n失败时间: ${new Date().toLocaleString('zh-CN')}`,
    }
  );
}

