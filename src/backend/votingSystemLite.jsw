import wixData from "wix-data";
import { currentMember } from "wix-members-backend";
import { QUERY_LIMITS } from "backend/constants";

const VOTE2_COLLECTION = "ThemeVote2";

async function isCurrentUserAdmin() {
  try {
    const roles = await currentMember.getRoles();
    return (roles || []).some(
      (role) => role.title === "Admin" || role.name === "Admin"
    );
  } catch (error) {
    return false;
  }
}

async function checkIfUserVoted(userId) {
  const results = await wixData
    .query(VOTE2_COLLECTION)
    .eq("_owner", userId)
    .limit(QUERY_LIMITS.VOTE_QUERY_LIMIT)
    .find();

  return results.items.length > 0;
}

export async function getVote2Status(userId) {
  try {
    const hasVoted = await checkIfUserVoted(userId);
    const isAdmin = await isCurrentUserAdmin();
    return { hasVoted, isAdmin };
  } catch (error) {
    console.error("获取用户投票状态失败:", error);
    throw error;
  }
}

export async function getVote2Options() {
  try {
    return {
      options: [
        { value: "80", label: "80 眼睛想旅行" },
        { value: "71", label: "71 ReDreaming Angel 复梦天使" },
        { value: "28", label: "28 水手怕水" },
        { value: "72", label: "72 妳是我的花朵" },
        { value: "38", label: "38 万象霜天" },
        { value: "51", label: "51 冠世一战" },
        { value: "65", label: "65 忘记了也没关系" },
        { value: "8", label: "8 伞护" },
        { value: "114", label: "114 護花使者" }
      ]
    };
  } catch (error) {
    console.error("获取投票选项失败:", error);
    throw error;
  }
}

export async function submitVote2(userId, userName, themeValues) {
  try {
    const hasVoted = await checkIfUserVoted(userId);
    if (hasVoted) {
      return {
        success: false,
        message: "您已经投过票了"
      };
    }

    if (!Array.isArray(themeValues) || themeValues.length !== 2) {
      return {
        success: false,
        message: "请选择两个选项"
      };
    }

    const voteData = {
      userName,
      themeValues,
      voteDate: new Date()
    };

    const result = await wixData.save(VOTE2_COLLECTION, voteData);

    return {
      success: true,
      voteId: result._id,
      message: "投票成功"
    };
  } catch (error) {
    console.error("提交投票失败:", error);
    return {
      success: false,
      message: "提交投票失败，请稍后重试"
    };
  }
}

export async function getVote2Results(userId) {
  try {
    const hasVoted = await checkIfUserVoted(userId);
    const isAdmin = await isCurrentUserAdmin();
    if (!hasVoted && !isAdmin) {
      return {
        allowed: false,
        labels: [],
        data: [],
        voters: []
      };
    }

    const results = await wixData
      .query(VOTE2_COLLECTION)
      .ascending("voteDate")
      .limit(QUERY_LIMITS.VOTE_QUERY_LIMIT)
      .find();

    if (results.items.length === 0) {
      return {
        allowed: true,
        labels: [],
        data: [],
        voters: []
      };
    }

    const voteCounts = {};
    const voteVoters = {};

    results.items.forEach((item) => {
      const userName = item.userName;
      const themes = Array.isArray(item.themeValues)
        ? item.themeValues
        : item.themeValue
          ? [item.themeValue]
          : [];

      themes.forEach((theme) => {
        voteCounts[theme] = (voteCounts[theme] || 0) + 1;

        if (!voteVoters[theme]) {
          voteVoters[theme] = [];
        }
        if (userName) {
          voteVoters[theme].push(userName);
        }
      });
    });

    const options = await getVote2Options();
    const optionList = Array.isArray(options.options) ? options.options : [];

    if (optionList.length === 0) {
      const labels = Object.keys(voteCounts);
      return {
        allowed: true,
        labels,
        data: labels.map((label) => voteCounts[label] || 0),
        voters: labels.map((label) => (voteVoters[label] || []).join(", "))
      };
    }

    const labels = [];
    const data = [];
    const voters = [];

    optionList.forEach((option) => {
      labels.push(option.label);
      data.push(voteCounts[option.value] || 0);
      voters.push((voteVoters[option.value] || []).join(", "));
    });

    return {
      allowed: true,
      labels,
      data,
      voters
    };
  } catch (error) {
    console.error("获取投票结果失败:", error);
    throw error;
  }
}
